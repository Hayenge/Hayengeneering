//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// EMA Trend-Follow — Optimized (Slides 1 & 6)
// BTC/USDT 1D | EMA 18/50 + ADX(14) + ATR(10) trailing stop
//
// Paste into TradingView Pine Script editor.
// Set chart to: BTC/USDT, Daily
// ─────────────────────────────────────────────────────────────────────────────
strategy(
    title              = "EMA Trend-Follow Optimized",
    overlay            = true,
    initial_capital    = 10000,
    default_qty_type   = strategy.cash,
    default_qty_value  = 150,       // $150 risk per trade (1.5% of $10k)
    commission_type    = strategy.commission.percent,
    commission_value   = 0.1,
    slippage           = 2
)

// ── Inputs ───────────────────────────────────────────────────────────────────
grp_ema    = "EMA Settings"
ema_fast   = input.int(18,  "Fast EMA",         group=grp_ema)
ema_slow   = input.int(50,  "Slow EMA",         group=grp_ema)
ema_long   = input.int(200, "Trend Filter EMA", group=grp_ema)

grp_atr    = "ATR / Stops"
atr_len    = input.int(10,   "ATR Length",          group=grp_atr)
atr_stop   = input.float(1.2,"Stop ATR mult",       group=grp_atr, step=0.1)
atr_be     = input.float(1.5,"Break-even ATR mult", group=grp_atr, step=0.1)
atr_trail  = input.float(1.0,"Trail ATR mult",      group=grp_atr, step=0.1)

grp_filter = "Entry Filters"
adx_len    = input.int(14,  "ADX Length",           group=grp_filter)
adx_min    = input.float(25,"ADX Minimum",          group=grp_filter)
rsi_len    = input.int(14,  "RSI Length",           group=grp_filter)
rsi_lo     = input.float(40,"RSI Min",              group=grp_filter)
rsi_hi     = input.float(70,"RSI Max",              group=grp_filter)
vol_len    = input.int(20,  "Volume MA Length",     group=grp_filter)
vol_mult   = input.float(1.2,"Volume Multiplier",   group=grp_filter, step=0.1)
vol_skip   = input.float(6.0,"Skip if ATR/Close > (%)", group=grp_filter)

// ── Indicators ───────────────────────────────────────────────────────────────
ema_f  = ta.ema(close, ema_fast)
ema_s  = ta.ema(close, ema_slow)
ema_l  = ta.ema(close, ema_long)
atr    = ta.atr(atr_len)
rsi    = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_len)

// ADX
[pdi, ndi, adx] = ta.dmi(adx_len, adx_len)

// 200-EMA 5-day slope
ema_slope = ema_l - ema_l[5]

// 10-bar high (from prior bars, so not look-ahead)
high10 = ta.highest(high, 10)[1]

// ── Entry Conditions ─────────────────────────────────────────────────────────
ema_crossover = ta.crossover(ema_f, ema_s)

entry_ok = ema_crossover
         and adx          >= adx_min
         and rsi          >= rsi_lo  and rsi  <= rsi_hi
         and close        >  ema_l
         and ema_slope    >  0
         and volume       >= vol_mult * vol_ma
         and (atr / close * 100) <= vol_skip
         and close        >  high10

// ── Position State ────────────────────────────────────────────────────────────
var float stop_price  = na
var float be_trigger  = na
var bool  be_done     = false

if entry_ok and strategy.position_size == 0
    entry_px   = open                                // enter at next bar's open
    stop_price := entry_px - atr_stop * atr
    be_trigger := entry_px + atr_be   * atr
    be_done    := false

    // Size: risk $150 ÷ stop distance (units of the base asset)
    risk_amount = strategy.equity * 0.015
    qty         = risk_amount / (atr_stop * atr)
    strategy.entry("Long", strategy.long, qty=qty, comment="EMA Cross")

// Manage open trade
if strategy.position_size > 0
    // Break-even promotion
    if not be_done and high >= be_trigger
        stop_price := strategy.position_avg_price
        be_done    := true

    // Trail stop upward only
    trail = close - atr_trail * atr
    if trail > stop_price
        stop_price := trail

    strategy.exit("Exit", from_entry="Long", stop=stop_price, comment="Trail/Stop")

// ── Visuals ───────────────────────────────────────────────────────────────────
plot(ema_f, "EMA Fast",  color=color.new(color.lime,   0), linewidth=2)
plot(ema_s, "EMA Slow",  color=color.new(color.orange, 0), linewidth=2)
plot(ema_l, "EMA 200",   color=color.new(color.gray,  40), linewidth=1)

plotshape(
    entry_ok,
    title    = "Entry Signal",
    style    = shape.triangleup,
    location = location.belowbar,
    color    = color.lime,
    size     = size.small,
    text     = "EMA+"
)

plot(
    strategy.position_size > 0 ? stop_price : na,
    "Stop Level",
    color     = color.red,
    style     = plot.style_circles,
    linewidth = 2
)

// ADX background tint — grey when trend too weak to trade
bgcolor(adx < adx_min ? color.new(color.gray, 92) : na, title="Weak Trend")

// ── ADX / RSI in separate pane (optional — add to new pane) ──────────────────
// Uncomment if you want these visible without a separate indicator:
// plot(adx,     "ADX",   color=color.yellow, display=display.pane)
// plot(adx_min, "ADXmin",color=color.gray,   display=display.pane)
// hline(50, "RSI 50", color=color.gray,      display=display.pane)
// plot(rsi,     "RSI",   color=color.aqua,   display=display.pane)
